{
  "name": "my-mac-widgets",
  "version": "2.0.0",
  "description": "A reusable macOS Übersicht widget host: one local helper serving many widget data providers, starting with Claude Code usage statistics.",
  "type": "commonjs",
  "bin": {
    "widget-helper": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js serve",
    "list": "node src/cli.js list",
    "parse": "node src/cli.js parse",
    "print": "node src/cli.js print",
    "deploy": "./scripts/deploy.sh",
    "new-widget": "./scripts/new-widget.sh",
    "test": "node test/run.js"
  },
  "engines": {
    "node": ">=18.15.0"
  },
  "license": "MIT",
  "dependencies": {}
}
